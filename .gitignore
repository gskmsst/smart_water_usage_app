# ----------------------------------------------------------------------
# Flutter / Dart General
# ----------------------------------------------------------------------
# Build output directory
build/

# Ephemeral Dart/Flutter files generated during build or packages pub get
.dart_tool/
.packages
.pub-cache/
.pub/

# Avoid committing local configurations
local.properties

# Symbol map files generated when building release apps
*.symbols
*.map

# ----------------------------------------------------------------------
# Android
# ----------------------------------------------------------------------
# Android Studio / Gradle output
android/.gradle/
android/captures/
android/app/build/
android/app/profile/
android/app/release/
android/app/debug/

# Android generated plugin code
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# ----------------------------------------------------------------------
# iOS / macOS
# ----------------------------------------------------------------------
# Xcode build and ephemeral files
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app_framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec

**/macos/Flutter/ephemeral/
**/macos/Flutter/ephemeral/Flutter-Generated.xcconfig

# Xcode user settings and build outputs
**/Pods/
**/.symlinks/
*.xcworkspace
!**/Runner.xcworkspace
*.xcodeproj/*
!**/Runner.xcodeproj/project.pbxproj
!**/Runner.xcodeproj/xcshareddata/
!**/Runner.xcworkspace/contents.xcworkspacedata
**/xcuserdata/

# Derived Data & Archives
*.xcarchive

